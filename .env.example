# GGUF file inside ./models (see models/README.md)
MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# Host port for the web UI (bound to localhost only)
WEB_PORT=8080

# llama.cpp context window (shared between parallel slots) and slot count
LLM_CTX=4096
LLM_PARALLEL=1

# RAG tuning: fewer chunks and fewer generated tokens = faster answers
RAG_TOP_K=5
LLM_MAX_TOKENS=500
